# OpenAI (offline agent / evolve only — never required on the proxy hot path)
OPENAI_API_KEY=

# OpenTelemetry (optional — leave empty for no-op)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional overrides for config/proxy.yaml
# PROXY_CONFIG=config/proxy.yaml
# EVOLVE_CONFIG=config/evolve.yaml
# DATA_DIR=data

# Any OpenAI-compatible API (optional). The benchmark defaults to Groq: set GROQ_API_KEY and run scripts/bench/run-all.sh.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MAX_RETRIES=10
# GROQ_API_KEY=
